{
  "name": "advokat-site",
  "version": "1.0.0",
  "description": "Адвокатский кабинет - сайт адвоката Ежова А.В.",
  "scripts": {
    "build:css": "sass assets/scss/style.scss assets/css/style.css --style=expanded",
    "build:min": "sass assets/scss/style.scss assets/css/style.min.css --style=compressed",
    "images": "node scripts/optimize-images.js",
    "images:force": "node scripts/optimize-images.js --force",
    "images:watch": "node scripts/optimize-images.js --watch",
    "build": "run-p build:css build:min images",
    "watch:css": "sass --watch assets/scss/style.scss:assets/css/style.css --style=expanded",
    "watch:min": "sass --watch assets/scss/style.scss:assets/css/style.min.css --style=compressed",
    "watch": "run-p watch:css watch:min images:watch",
    "dev": "npm run watch",
    "start": "npm run watch"
  },
  "keywords": [
    "scss",
    "sass",
    "images",
    "optimization",
    "webp",
    "avif",
    "advokat"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "chokidar": "^4.0.3",
    "npm-run-all": "^4.1.5",
    "sass": "^1.103.1",
    "sharp": "^0.33.5"
  }
}